<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Calcpad.Plugin.AskAi</RootNamespace>
    <AssemblyName>Calcpad.Plugin.AskAi</AssemblyName>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Calcpad.Plugin.ScientificCalculator</RootNamespace>
    <AssemblyName>Calcpad.Plugin.ScientificCalculator</AssemblyName>
    <IsPackable>false</IsPackable>
    <Description>iPad landscape scientific calculator widget for the Calcpad infinite canvas.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Calcpad.Plugin.Sdk\Calcpad.Plugin.Sdk.csproj" />
  </ItemGroup>

  <!-- The keypad state machine, the paint helpers and the calculator surface kit are shared with the
       basic calculator by compiling the same sources into this assembly; the plugins stay
       independently loadable. The wildcard keeps the list complete when the kit grows; the plugin
       entry point and the widget renderers are excluded so this assembly declares exactly one IPlugin. -->
  <ItemGroup>
    <Compile Include="..\Calcpad.Plugin.BasicCalculator\*.cs" LinkBase="Shared\CalculatorKit"
             Exclude="..\Calcpad.Plugin.BasicCalculator\BasicCalculatorPlugin.cs;..\Calcpad.Plugin.BasicCalculator\BasicCalculatorWidget.cs;..\Calcpad.Plugin.BasicCalculator\CalculatorSurfaceWidget.cs" />
  </ItemGroup>

</Project>

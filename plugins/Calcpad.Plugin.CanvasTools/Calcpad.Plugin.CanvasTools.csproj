<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Calcpad.Plugin.CanvasTools</RootNamespace>
    <AssemblyName>Calcpad.Plugin.CanvasTools</AssemblyName>
    <IsPackable>false</IsPackable>
    <Description>Built-in Calcpad plugin: canvas tools (pen, highlighter, eraser, lasso, marquee, text, shape) plus the PNG rasteriser used by handwriting recognition and ask-AI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Calcpad.Core\Calcpad.Core.csproj" />
    <ProjectReference Include="..\..\src\Calcpad.Plugin.Sdk\Calcpad.Plugin.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The document renderer is shared source: it lives in the application so the live canvas and the
      offscreen rasteriser can never drift apart, and it is linked here so this plugin does not need
      a reference to Calcpad.App (which references this project).
    -->
    <Compile Include="..\..\src\Calcpad.App\Views\Canvas\CanvasDocumentRenderer.cs" Link="Rendering\CanvasDocumentRenderer.cs" />
  </ItemGroup>

</Project>

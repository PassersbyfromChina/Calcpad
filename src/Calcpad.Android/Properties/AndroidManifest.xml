<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Calcpad is a local first calculator. INTERNET is declared because cloud AI is an opt in
    feature; it is never used without an explicit per request approval from the EgressGuard.
    No camera, microphone, storage or location permission is requested.
  -->
  <uses-permission android:name="android.permission.INTERNET" />

  <application android:label="Calcpad"
               android:allowBackup="false"
               android:supportsRtl="true"
               android:hardwareAccelerated="true" />
</manifest>

<Project>
  <PropertyGroup>
    <!-- Calcpad starts at 0.0.0 by explicit product decision. -->
    <Version>0.0.0</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <Product>Calcpad</Product>
    <AssemblyTitle>Calcpad</AssemblyTitle>
    <Company>PassersbyfromChina</Company>
    <Authors>PassersbyfromChina</Authors>
    <Copyright>Copyright (c) 2026 PassersbyfromChina</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/PassersbyfromChina/Calcpad.git</RepositoryUrl>
    <Description>Infinite-canvas, plugin-driven calculator for Android, Windows x64 and Windows on Arm.</Description>
    <PackageTags>calculator;canvas;plugin;handwriting;ocr;ai;android;windows;arm64</PackageTags>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;CS1591</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
  </PropertyGroup>
</Project>
